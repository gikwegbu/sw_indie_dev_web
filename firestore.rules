rules_version = '2';

service cloud.firestore {

match /databases/{database}/documents {function isSignedIn() { return request.auth != null; }
function isSuperAdmin() {
  return isSignedIn() &&
    get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superAdmin';
}

// Public read for content collections
match /members/{doc}           { allow read: if true; allow write: if isSignedIn(); }
match /projects/{doc}          { allow read: if true; allow write: if isSignedIn(); }
match /upcomingEvents/{doc}    { allow read: if true; allow write: if isSignedIn(); }
match /pastEvents/{doc}        { allow read: if true; allow write: if isSignedIn();
  match /talks/{talk}          { allow read: if true; allow write: if isSignedIn(); } }
match /outreach/{doc}          { allow read: if true; allow write: if isSignedIn(); }
match /settings/{doc}          { allow read: if true; allow write: if isSignedIn(); }

// Admin-only collections
match /adminAuditLog/{doc}     { allow read, write: if isSuperAdmin(); }
match /bin/{doc}               { allow read, write: if isSignedIn(); }
match /admins/{doc}            { allow read: if isSignedIn();
                                 allow write: if isSuperAdmin(); }
}

}
